1 ICON "icon.ico"
1 24 "launcher.manifest"
1 VERSIONINFO
FILEVERSION @NUM@
PRODUCTVERSION @NUM@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Megageorgio"
      VALUE "FileDescription", "mLabeler"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "mLabeler"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "mLabeler.exe"
      VALUE "ProductName", "mLabeler"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "Comments", "Phoneme labelling editor. Source: https://github.com/Megageorgio/mlabeler"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
